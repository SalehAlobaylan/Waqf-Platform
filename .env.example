# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-long-random-secret"

# GitHub OAuth (optional, for GitHub login)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (optional, for Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# File Uploads (optional, using UploadThing)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Email (optional, using Resend)
RESEND_API_KEY=""
FROM_EMAIL="Waqf Platform <noreply@waqf.dev>"

# Real-time Messaging (optional, using Pusher)
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# App URL (used in emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Weekly admin report (POST /api/admin/weekly-report, GitHub Actions cron)
# WEEKLY_REPORT_SECRET is the x-cron-secret header value; WEEKLY_REPORT_TO is
# the recipient inbox. Route returns 404 unless the secret is set.
WEEKLY_REPORT_SECRET="replace-with-long-random-secret"
WEEKLY_REPORT_TO="ops@example.com"

# Toolkit showcase (Islamic Digital Toolkit is first consumer of generic open-source fields)
# Independent deployment URL and GitHub repo — used for flagship band and project showcase
TOOLKIT_URL="https://waqf-toolkit.vercel.app"
TOOLKIT_GITHUB_URL="https://github.com/waqf-platform/waqf-toolkit"

# Dev sign-in helper (POST /api/dev/sign-in-as + LoginForm quick sign-in panel)
# Set to "true" only in local/CI. Never set in preview, staging, or production.
ENABLE_DEV_LOGIN="false"
NEXT_PUBLIC_ENABLE_DEV_LOGIN="false"
