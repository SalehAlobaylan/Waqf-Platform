    "legal": {
        "privacy": {
            "title": "Privacy Policy",
            "updated": "Last updated: 2026",
            "intro": "Waqf (\"we\", \"us\") is a contribution platform that matches developers with projects that need help. This policy explains what data we collect, why we collect it, and the choices you have.",
            "sections": [
                {
                    "title": "1. Data we collect",
                    "body": "Account information: name, email address, and a username when you register. Profile information: biography, skills, timezone, and links you choose to add. Contribution data: projects, applications, messages, and other activity on the platform. Technical data: IP address, browser type, and pages visited, collected automatically."
                },
                {
                    "title": "2. How we use your data",
                    "body": "We use your data to operate the platform: to authenticate you, match you with projects, deliver messages and notifications, moderate content, and improve our services. We do not sell your personal data."
                },
                {
                    "title": "3. What is public",
                    "body": "Your public profile — name, biography, skills, and portfolio — is visible to other users. Messages between contributors and project owners are visible to the participants. Project and campaign pages are public by design."
                },
                {
                    "title": "4. Sharing with service providers",
                    "body": "We share limited data with the providers we rely on to run the platform, such as hosting, email delivery, and file storage. These providers are bound by confidentiality and may only process data on our instructions."
                },
                {
                    "title": "5. Data retention",
                    "body": "We keep your data for as long as your account is active and for a reasonable period afterwards, and delete it sooner when you ask us to or when the law requires it."
                },
                {
                    "title": "6. Your rights",
                    "body": "You may access, correct, or delete your personal data at any time from your settings, or by contacting us. You may also export your data and close your account."
                },
                {
                    "title": "7. Children",
                    "body": "The platform is intended for developers aged 16 and over. We do not knowingly collect data from children."
                },
                {
                    "title": "8. Changes to this policy",
                    "body": "We may update this policy as the platform evolves. Material changes will be announced on the platform or by email."
                },
                {
                    "title": "9. Contact",
                    "body": "Questions about this policy? Reach us at privacy@waqf.dev."
                }
            ]
        },
        "terms": {
            "title": "Terms of Service",
            "updated": "Last updated: 2026",
            "intro": "These terms govern your use of the Waqf platform. By creating an account, you agree to them.",
            "sections": [
                {
                    "title": "1. The service",
                    "body": "Waqf is a contribution platform for developers. It matches people who want to contribute time and skills with project owners who need help — whether the project is open-source, closed, or private."
                },
                {
                    "title": "2. Eligibility",
                    "body": "You must be at least 16 years old and capable of entering a binding agreement to use the platform."
                },
                {
                    "title": "3. Your account",
                    "body": "You are responsible for safeguarding your credentials and for everything done with your account. Notify us promptly of any unauthorized use."
                },
                {
                    "title": "4. Your content",
                    "body": "You retain ownership of the content you post. You grant the platform a license to store, display, and process it in order to operate the service. You are responsible for the accuracy and lawfulness of what you post."
                },
                {
                    "title": "5. Contributions",
                    "body": "When you contribute to a project, the licensing and ownership terms of that project apply. The platform is not a party to contributor–owner agreements and takes no responsibility for them."
                },
                {
                    "title": "6. Acceptable use",
                    "body": "You agree not to: post unlawful or infringing content, attempt to access other users' accounts or data, interfere with the platform's operation, or use it to spam, scam, or harass others."
                },
                {
                    "title": "7. Moderation",
                    "body": "Project owners moderate applications and contributions on their projects. Platform administrators may remove content and suspend accounts that violate these terms."
                },
                {
                    "title": "8. Disclaimers",
                    "body": "The platform is provided \"as is\" without warranties of any kind, express or implied. We do not guarantee that the service will be uninterrupted or error-free."
                },
                {
                    "title": "9. Limitation of liability",
                    "body": "To the maximum extent permitted by law, Waqf is not liable for indirect, incidental, or consequential damages arising from your use of the platform."
                },
                {
                    "title": "10. Changes to these terms",
                    "body": "We may revise these terms. Continued use of the platform after changes take effect constitutes acceptance."
                },
                {
                    "title": "11. Contact",
                    "body": "Questions about these terms? Reach us at legal@waqf.dev."
                }
            ]
        },
        "contact": {
            "title": "Contact Us",
